# Create a boxplot
figname <- paste0(OUTFIGS, filesep, "Fig4B_", thedate, ".png")
png(figname)
boxplot(accuracy ~ Class_id, data = data, ylab = "Accuracy", cex.axis = 2, cex.lab = 1.7)
dev.off()
# Display the saved plot
la <- plotPNGorTIF(figname)
