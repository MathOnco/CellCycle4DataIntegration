library(readr)
library(ggplot2)
# Read the CSV file
data <- read.table(paste0(OUTPSEUDOTIME, filesep,"CNN_3ch_03032025_fl32_dataMerged_v2_test_accuracy_per_fof_and_class_id.txt"),header = TRUE, sep = "", stringsAsFactors = FALSE)
